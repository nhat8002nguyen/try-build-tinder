# Server Configuration
SERVER_PORT=8080
ENVIRONMENT=development
# Frontend URL for OAuth redirect (no trailing slash)
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tinder_clone?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE_HOURS=24

# OAuth - Google (Optional)
# Get credentials from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/oauth/google/callback

# OAuth - Facebook (Optional)
# Get credentials from: https://developers.facebook.com/
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URL=http://localhost:8080/api/auth/oauth/facebook/callback

# Storage Configuration
# Options: local, s3
STORAGE_TYPE=local
LOCAL_STORAGE_DIR=./uploads

# Optional: S3 Storage (if STORAGE_TYPE=s3)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
