# Production Environment Variables
# Copy this file to .env.production and fill in the values

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=tinder_clone

# Redis Configuration
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# JWT Configuration
JWT_SECRET=CHANGE_ME_SUPER_SECRET_JWT_KEY_AT_LEAST_32_CHARS
JWT_EXPIRE_HOURS=168

# Storage Configuration
# Options: local, s3
STORAGE_TYPE=local

# AWS S3 Configuration (if STORAGE_TYPE=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# OAuth - Google (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://your-domain.com/api/auth/oauth/google/callback

# OAuth - Facebook (Optional)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URL=https://your-domain.com/api/auth/oauth/facebook/callback

# Domain Configuration (API: api.vnhatng.com, Frontend: spark.vnhatng.com)
DOMAIN_NAME=api.vnhatng.com
FRONTEND_DOMAIN=spark.vnhatng.com
EMAIL_FOR_SSL=your-email@example.com
