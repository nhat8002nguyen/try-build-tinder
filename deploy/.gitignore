# .gitignore for deploy directory

# Environment files with secrets
.env.production
.env.prod
.env

# Backup files
backups/
*.sql
*.sql.gz
*.tar.gz
*.zip

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
*.tmp

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# SSL certificates (generated by certbot)
certs/
*.pem
*.key
*.crt
*.pub

# Keep example files
!.env.production.example

github-actions-key
